# Ignore everything
*

# Allow directory traversal
!**/

# General file patterns
!*.yaml
!*.json
!*.sh
!*.tsv
!*.hcl
!*.example
!Dockerfile
!Chart.lock
!README.md
!docs/**/*.md

# Blog post images (scoped to docs/blog/ to keep the rest of the repo image-free)
!docs/blog/**/*.png
!docs/blog/**/*.gif

# Terraform (scoped to prevent auto-generated files in terraform/live/)
!terraform/modules/**/*.tf

# Keep hidden files and directories ignored
.*

# Whitelist specific hidden items
!.gitignore
!.gitkeep
!.github
!.gitattributes
!.gitleaks.toml
