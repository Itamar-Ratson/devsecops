# Copy to secrets.tfvars and fill in values.
# IMPORTANT: Never commit secrets.tfvars to git.
#
# This file serves two purposes:
#   1. vault/transit reads vault_root_token (admin-only, one-time, revoke after first apply)
#   2. aws/ssm reads all other secrets to seed AWS SSM Parameter Store
#
# After aws/ssm is applied once, team members only need AWS credentials -- no secrets.tfvars.

# -- vault/transit (admin-only, one-time) --------------------------------------
# Transit Vault root token (generate: openssl rand -base64 32)
# Revoke immediately after vault/transit succeeds.
vault_root_token = ""

# -- aws/ssm seed values -------------------------------------------------------

# GitHub token for managing ArgoCD deploy keys (needs admin:repo_key or repo scope)
github_token = ""

# OIDC client secrets (generate each: openssl rand -hex 32)
oidc_client_secrets = {
  argocd           = ""
  grafana          = ""
  vault            = ""
  headlamp         = ""
  cloudflare-access = ""
}

# Keycloak admin credentials
keycloak_admin = {
  username = "admin"
  password = ""
}

# Grafana admin credentials
grafana_admin = {
  username = "admin"
  password = ""
}

# ArgoCD admin credentials
# password_hash: htpasswd -nbBC 10 "" 'your-password' | tr -d ':\n'
# server_secret_key: openssl rand -base64 32
argocd_admin = {
  password_hash     = ""
  server_secret_key = ""
}

# Alertmanager webhooks (use "DISABLED" to disable a channel)
alertmanager_webhooks = {
  pagerduty_routing_key  = "DISABLED"
  slack_critical_webhook = "DISABLED"
  slack_warning_webhook  = "DISABLED"
}

# CloudFlare API token (Tunnel + DNS + Access Edit permissions)
cloudflare_api_token = ""

# CloudFlare account ID
cloudflare_account_id = ""

# CloudFlare zone ID for your domain
cloudflare_zone_id = ""

# Let's Encrypt ACME email (certificate expiry notifications)
letsencrypt_email = ""

# Tailscale auth key for KinD subnet router
# Generate in Tailscale admin: Settings → Keys → Generate auth key
# Options: reusable + ephemeral + tag:k8s
tailscale_auth_key = ""

# Tailscale auth key for EKS subnet router
# Generate in Tailscale admin: Settings → Keys → Generate auth key
# Options: reusable + ephemeral + tag:eks
tailscale_eks_auth_key = ""

# Slack incoming webhook for DevOps project channel (key rotation reminders)
slack_devops_webhook = ""

# AWS IAM credentials for Crossplane S3 provisioning
# Create a dedicated IAM user with AmazonS3FullAccess (or scoped policy)
aws_credentials = {
  access_key_id     = ""
  secret_access_key = ""
}
